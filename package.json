{
  "name": "job-autopilot",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: job discovery + memory-based autofill with an approval gate (never auto-submits).",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-scripts.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-page": "vite test-pages --port 5174 --strictPort"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "typescript": "~5.9.3",
    "vite": "^5",
    "vitest": "^2"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18"
  }
}
